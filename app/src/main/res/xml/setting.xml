<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:iconSpaceReserved="false">

    <PreferenceCategory
            app:iconSpaceReserved="false"
            app:title="@string/setting_section">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"
                app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <SwitchPreferenceCompat
                app:iconSpaceReserved="false"
                app:key="xhs_fingerprint_dump"
                app:title="@string/xhs_fingerprint_dump"
                app:summary="@string/xhs_fingerprint_dump_summary" />

        <Preference
                android:key="send_logs"
                android:title="@string/send_logs"
                android:summary="@string/send_logs_summary"
                app:iconSpaceReserved="false" />

    </PreferenceCategory>

</PreferenceScreen>